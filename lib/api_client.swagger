                "consumes": [
                    "application\/json",
                    "application\/x-www-form-urlencoded"
                ],
                "produces": [
                    "application\/json"
                ],
                "operationId": "profile_put_update_customer_profile",
                "description": "",
                "parameters": [
                    {
                        "name": "first_name",
                        "in": "formData",
                        "required": true,
                        "description": "First name",
                        "type": "string"
                    },
                    {
                        "name": "last_name",
                        "in": "formData",
                        "required": false,
                        "description": "Last name",
                        "type": "string"
                    },
                    {
                        "name": "email",
                        "in": "formData",
                        "required": true,
